file.exists("prostate.csv")
file.exists("webr-exercises.html")
# Read the existing webR configuration
html <- readLines("webr-exercises.html", warn = FALSE)
# Read the prostate dataset
csv <- readLines("prostate.csv", warn = FALSE)
# Find the existing dataset collection
position <- grep("const csvData = {", html, fixed = TRUE)
stopifnot(length(position) == 1)
# Prevent adding the same dataset twice
if (any(grepl("'prostate.csv':", html, fixed = TRUE))) {
stop("The prostate dataset is already included.")
}
# Prepare the dataset in JavaScript format
new_data <- c(
"      'prostate.csv': `",
csv,
"`,"
)
# Insert it into the existing collection
updated_html <- append(
html,
new_data,
after = position
)
# Save a backup of the original file
file.copy(
"webr-exercises.html",
"webr-exercises-backup.html",
overwrite = TRUE
)
# Save the updated configuration
writeLines(updated_html, "webr-exercises.html")
cat("Prostate dataset added successfully!\n")
